# DeepTrace Environment Variables
# Copy this file to .env and fill in your actual keys.
# Never commit .env to version control.

# Required: OpenRouter API key for LLM access
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Required for Phase 4B: Tavily Search API key
# Get a free key at https://tavily.com (1,000 searches/month on free tier)
TAVILY_API_KEY=your_tavily_api_key_here

# Required for Phase 5: PostgreSQL Database
POSTGRES_USER=deeptrace
POSTGRES_PASSWORD=deeptrace_password
POSTGRES_DB=deeptrace_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Required for Phase 6: LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=DeepTrace
